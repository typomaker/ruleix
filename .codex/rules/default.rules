prefix_rule(
    pattern = ["git", "push", "origin"],
    decision = "allow",
    justification = "Allow publishing this project's commits and tags to origin",
    match = [
        "git push origin main",
        "git push origin v0.4.1",
        "git push origin main --force-with-lease",
    ],
    not_match = [
        "git push upstream main",
        "git fetch origin",
    ],
)
